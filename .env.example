# Copy to .env and fill in. .env is gitignored.
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
YORK_CAP_USD=1.00

# Switch agent bridge (the API URL Console shows for your server) and its registration token
SWITCH_API_URL=http://127.0.0.1:10958
SWITCH_REGISTRATION_TOKEN=
# written by vegapunk.switch.register
PUNK_RECORDS_AGENT_ID=
PUNK_RECORDS_API_KEY=

# Satellites: Switch agent names and their working directories as seen from where Punk Records runs
SATELLITE_SHAKA_AGENT=
SATELLITE_SHAKA_WORKSPACE=
SATELLITE_LILITH_AGENT=
SATELLITE_LILITH_WORKSPACE=

# Stella: your username in each messaging app, so tribunal rooms invite you
STELLA_DISCORD=
STELLA_SLACK=
TRIBUNAL_BRIDGE=discord
# your GitHub login, excluded from sealed rankings (looked up from the token if empty)
OUR_GITHUB_LOGIN=
